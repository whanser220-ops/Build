%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f4b33f1d5434e7f9cf2d7b0e7a13142, type: 3}
  m_Name: ProjectFbxImportRuleSet
  m_EditorClassIdentifier:
  rules:
  - name: Character Source Animations
    glob: Characters/**/SourceAnimations/**/*.fbx
    kind: 2
    rig: 2
    preserveHierarchy: 0
    importAnimation: 1
    importBlendShapes: 0
    generateLightmapUv: 0
    generateColliders: 0
    readWrite: 0
    meshCompression: 0
    animationCompression: 3
  - name: Character At-Sign Animations
    glob: Characters/**/*@*.fbx
    kind: 2
    rig: 2
    preserveHierarchy: 0
    importAnimation: 1
    importBlendShapes: 0
    generateLightmapUv: 0
    generateColliders: 0
    readWrite: 0
    meshCompression: 0
    animationCompression: 3
  - name: At-Sign Animations
    glob: '*@*.fbx'
    kind: 2
    rig: 1
    preserveHierarchy: 0
    importAnimation: 1
    importBlendShapes: 0
    generateLightmapUv: 0
    generateColliders: 0
    readWrite: 0
    meshCompression: 0
    animationCompression: 3
  - name: Characters
    glob: Characters/**/*.fbx
    kind: 1
    rig: 2
    preserveHierarchy: 0
    importAnimation: 1
    importBlendShapes: 1
    generateLightmapUv: 0
    generateColliders: 0
    readWrite: 0
    meshCompression: 0
    animationCompression: 3
  - name: Props
    glob: Props/**/*.fbx
    kind: 0
    rig: 0
    preserveHierarchy: 0
    importAnimation: 0
    importBlendShapes: 0
    generateLightmapUv: 1
    generateColliders: 1
    readWrite: 0
    meshCompression: 1
    animationCompression: 3
  - name: Meadow Source Meshes
    glob: Stylized Pack - Meadow Environment/Sources/Meshes/**/*.fbx
    kind: 0
    rig: 0
    preserveHierarchy: 1
    importAnimation: 0
    importBlendShapes: 0
    generateLightmapUv: 0
    generateColliders: 0
    readWrite: 0
    meshCompression: 1
    animationCompression: 3
  - name: LOD Filename
    glob: '*LOD*.fbx'
    kind: 0
    rig: 0
    preserveHierarchy: 1
    importAnimation: 0
    importBlendShapes: 0
    generateLightmapUv: 0
    generateColliders: 0
    readWrite: 0
    meshCompression: 1
    animationCompression: 3
  - name: Fallback Static Model
    glob: '*.fbx'
    kind: 0
    rig: 0
    preserveHierarchy: 0
    importAnimation: 0
    importBlendShapes: 0
    generateLightmapUv: 0
    generateColliders: 0
    readWrite: 0
    meshCompression: 1
    animationCompression: 3
