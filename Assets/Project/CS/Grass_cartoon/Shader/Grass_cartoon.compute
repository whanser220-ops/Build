#pragma kernel CSMain

Texture2D<float4> _TerrainHeightMap;
SamplerState sampler_TerrainHeightMap;

float3 _TerrainPosition;
float3 _TerrainSize;

float _DensityFadeStart;
float _DensityFadeEnd;
float _MinDensity;

struct GrassClumpParams
{
    float voronoiScale;
    float clusterTightness;
    float orientationUniformity;
    float typeOrientationUniformity;  // 新增：类型级朝向一致性

    float baseHeight;
    float baseWidth;
    float tilt;
    float bend;

    float heightVar;
    float widthVar;
    float tiltVar;
    float bendVar;

    float tipScale;           // 草尖宽度比例
    float midWidthScale;      // 中段宽度比例
    float rootWidthScale;     // 根部宽度比例
    float heightCurveBias;    // 高度重心偏移

    float p1Shape;            // P1 形态权重
    float p2Shape;            // P2 形态权重
    float p3Shape;            // P3 形态权重
    float sideBendStrength;   // 横向偏摆强度

    float stiffnessCurve;     // 根到尖的硬度曲线
    float tipBias;            // 草尖额外前甩
    float bendForwardAmount;  // 前向弯曲强度
    float tiltInfluence;      // tilt 对侧向偏移影响

    float uprightness;        // 直立程度
    float tipCurl;            // 草尖卷曲/外甩
    float arcBias;            // 主弧线偏前偏后

    float swayFrequency;      // 该草族摆动频率
    float windP1Influence;    // 风对 P1 影响
    float windP2Influence;    // 风对 P2 影响
    float windP3Influence;    // 风对 P3 影响
    float widthAttenPower;    // 宽度收尖速度
    float tipWidth;           // 尖端最小宽度比例

    // 聚类分布参数
    float clusterRadius;
    float clusterSigmaScale;
    uint maxBladesPerCluster;
};

struct GrassBlade
{
    float hash;
    float3 position;
    float facing;
    float height;
    float width;
    float tilt;
    float bend;
    float sideBend;
    float windForce;
    uint clumpIndex;
};

struct DispatchClusterInfo
{
    float3 worldCenter;
    float radius;
    float sigma;
    uint targetCount;
    uint seed;
    uint sampleOffset;
    uint clumpIndex;
};

StructuredBuffer<DispatchClusterInfo> _DispatchClusters;
int _DispatchClusterCount;

float4x4 _VPMatrix;
float3 _CameraPositionWS;
float _CullPadding;

Texture2D<float4> _LocalWindTex;
SamplerState sampler_LocalWindTex;

float _LocalWindScale;
float _LocalWindSpeed;
float _LocalWindRotateAmount;
float _LocalWindStrength;
int _HasLocalWind;
float4 _Time;

StructuredBuffer<GrassClumpParams> _ClumpParams;
int _ClumpCount;

AppendStructuredBuffer<GrassBlade> cullingOutputBuffer;

uint PCGHash(uint input)
{
    uint state = input * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float Random01(uint seed)
{
    return float(PCGHash(seed)) / 4294967295.0;
}

[numthreads(64, 1, 1)]
void CSMain(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    uint dispatchIdx = groupId.x;
    if (dispatchIdx >= (uint)_DispatchClusterCount)
        return;

    DispatchClusterInfo cluster = _DispatchClusters[dispatchIdx];
    uint localIdx = cluster.sampleOffset + groupThreadId.x;

    if (localIdx >= cluster.targetCount)
        return;

    if (_ClumpCount <= 0)
        return;

    uint sampleSeed = PCGHash(cluster.seed + localIdx * 2246822519u);

    float angle = Random01(sampleSeed + 1u) * 6.28318530718;
    float radius01 = sqrt(Random01(sampleSeed + 2u));
    float radius = cluster.radius * radius01;
    float2 dir = float2(cos(angle), sin(angle));
    float2 worldXZ = cluster.worldCenter.xz + dir * radius;

    float2 uv = (worldXZ - _TerrainPosition.xz) / max(_TerrainSize.xz, float2(0.0001, 0.0001));
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
        return;

    float sigma = max(cluster.sigma, 0.05);
    float density = exp(-0.5 * (radius * radius) / (sigma * sigma));
    if (Random01(sampleSeed + 3u) > density)
        return;

    uint clumpIdx = cluster.clumpIndex % (uint)_ClumpCount;
    GrassClumpParams settings = _ClumpParams[clumpIdx];

    float3 worldPos = float3(worldXZ.x, 0.0, worldXZ.y);
    float heightRatio = _TerrainHeightMap.SampleLevel(sampler_TerrainHeightMap, uv, 0).r;
    worldPos.y = _TerrainPosition.y + heightRatio * _TerrainSize.y;

    GrassBlade temp;
    temp.position = worldPos;
    temp.hash = Random01(cluster.seed);
    temp.clumpIndex = clumpIdx;

   
    float selfFacing = Random01(sampleSeed + 4u) * 6.28318530718;
    float clumpFacing = Random01(cluster.seed) * 6.28318530718;

    float clusterFacing = lerp(selfFacing, clumpFacing, settings.orientationUniformity);
    temp.facing = clusterFacing;

    float shapeMask = max(density, 0.15);
    float heightRnd = (Random01(sampleSeed + 30u) * 2.0 - 1.0) * settings.heightVar;
    temp.height = settings.baseHeight * (1.0 + heightRnd) * shapeMask;
    float widthRnd = (Random01(sampleSeed + 40u) * 2.0 - 1.0) * settings.widthVar;
    temp.width = settings.baseWidth * (1.0 + widthRnd) * shapeMask;

    float distToCam = distance(worldPos, _CameraPositionWS);
    float fadeT = saturate((distToCam - _DensityFadeStart) / (_DensityFadeEnd - _DensityFadeStart));
    fadeT = smoothstep(0.0, 1.0, fadeT);
    float keepProbability = lerp(1.0, _MinDensity, fadeT);
    if (Random01(localIdx) > keepProbability)
        return;

    float boundingRadius = temp.height;
    float4 clipPos = mul(_VPMatrix, float4(worldPos, 1.0));
    float cullMargin = boundingRadius + _CullPadding;

    bool isOut = false;
    if (abs(clipPos.x) > (clipPos.w + cullMargin)) isOut = true;
    if (abs(clipPos.y) > (clipPos.w + cullMargin)) isOut = true;
    if (clipPos.z < -cullMargin || clipPos.z > (clipPos.w + cullMargin)) isOut = true;
    if (isOut)
        return;

    temp.tilt = settings.tilt + (Random01(localIdx * 61349u + 50u) * 2.0 - 1.0) * settings.tiltVar;
    temp.bend = settings.bend + (Random01(localIdx * 53287u + 60u) * 2.0 - 1.0) * settings.bendVar;
    temp.sideBend = (Random01(localIdx * 47819u + 70u) * 2.0 - 1.0);

    temp.windForce = 0.0;
    if (_HasLocalWind != 0)
    {
        float2 worldUV = temp.position.xz;
        float2 localWindUV = worldUV * _LocalWindScale;
        localWindUV += _Time.y * float2(1, 0.7) * _LocalWindSpeed;

        float localWind = _LocalWindTex.SampleLevel(sampler_LocalWindTex, localWindUV, 0).r;

        float localTheta = ((localWind * 2) - 1) * 3.14159;
        float2 localWindDir = float2(cos(localTheta), sin(localTheta));
        float facingCos = cos(temp.facing);
        float facingSin = sin(temp.facing);
        float2 bladeFacing = float2(facingCos, facingSin);
        float2 grassSideVec = normalize(float2(-bladeFacing.y, bladeFacing.x));
        float rotateBladeFromLocalWindAmount = dot(grassSideVec, localWindDir);
        float localWindRotateAngle = rotateBladeFromLocalWindAmount * (3.14159 / 2) * _LocalWindRotateAmount;
        temp.facing += localWindRotateAngle;
        temp.windForce = localWind * _LocalWindStrength;
    }

    cullingOutputBuffer.Append(temp);
}
