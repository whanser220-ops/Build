#pragma kernel GenerateLeafCards
#pragma kernel EvaluateClusterOcclusion
#pragma kernel ResetVisibleCounter
#pragma kernel CullAndLod
#pragma kernel BuildIndirectArgs

static const float kTwoPi = 6.28318530718;
static const uint kCandidateAttempts = 4u;

struct StylizedCrownClusterData
{
    // 叶团级别的数据，由 CPU 上传并在 Compute/Pixel Shader 中共享。
    float3 centerWS;
    float radius;
    float3 axisXWS;
    float density;
    float3 axisYWS;
    float layer;
    float3 axisZWS;
    float depthInCrown;
    float3 extents;
    float ambientOccl;
    uint startCardIndex;
    uint cardCount;
    float directOcclBias;
    float directionalOcclusion;
    float directionalTransmittance;
    float upFacingBias;
    float shellBias;
    float leafSizeScale;
    float padding;
};

struct StylizedLeafCardData
{
    // 叶片卡片实例数据。生成后先写入 _AllLeafCards，再按需筛到 _VisibleLeafCards。
    float3 positionWS;
    float size;
    float3 localPosN;
    float rotation;
    float3 outwardNormalWS;
    float shell;
    float random01;
    float hueVariation;
    float ao;
    float windPhase;
    uint clusterId;
    float3 padding;
};

RWStructuredBuffer<StylizedCrownClusterData> _Clusters;
RWStructuredBuffer<StylizedLeafCardData> _AllLeafCards;
RWStructuredBuffer<StylizedLeafCardData> _VisibleLeafCards;
RWStructuredBuffer<uint> _VisibleCardCounter;
RWByteAddressBuffer _IndirectArgs;

uint _ClusterCount;
uint _TotalCardCount;
float2 _LeafSizeRange;
uint _GlobalRandomSeed;
float _GlobalShellBias;
float _CenterVoid;
float _GlobalUpBias;
float3 _LightDirectionWS;
float _ClusterOcclusionSigma;
float _ClusterOcclusionDistanceFade;
float3 _CameraPositionWS;
float _LodNearDistance;
float _LodFarDistance;
float _LodFarKeepRatio;
float _LodFarScale;
float4 _FrustumPlanes[6];
int _FrustumCullingEnabled;
float _FrustumCullPadding;

struct CandidateData
{
    float3 localPosN;
    float shell;
    float score;
};

uint Hash(uint value)
{
    value ^= 2747636419u;
    value *= 2654435769u;
    value ^= value >> 16;
    value *= 2654435769u;
    value ^= value >> 16;
    value *= 2654435769u;
    return value;
}

float Random01(inout uint state)
{
    state = Hash(state);
    return (state & 0x00FFFFFFu) / 16777216.0;
}

float3 SafeNormalize(float3 value)
{
    float lenSq = dot(value, value);
    if (lenSq < 1e-8)
        return float3(0.0, 1.0, 0.0);

    return value * rsqrt(lenSq);
}

float3 RandomUnitVector(inout uint state)
{
    float z = Random01(state) * 2.0 - 1.0;
    float angle = Random01(state) * kTwoPi;
    float radial = sqrt(saturate(1.0 - z * z));
    return float3(cos(angle) * radial, z, sin(angle) * radial);
}

float Hash31(float3 value)
{
    value = frac(value * 0.1031);
    value += dot(value, value.yzx + 33.33);
    return frac((value.x + value.y) * value.z);
}

float ValueNoise(float3 value)
{
    float3 baseValue = floor(value);
    float3 fraction = frac(value);
    float3 smoothFraction = fraction * fraction * (3.0 - 2.0 * fraction);

    float n000 = Hash31(baseValue + float3(0.0, 0.0, 0.0));
    float n100 = Hash31(baseValue + float3(1.0, 0.0, 0.0));
    float n010 = Hash31(baseValue + float3(0.0, 1.0, 0.0));
    float n110 = Hash31(baseValue + float3(1.0, 1.0, 0.0));
    float n001 = Hash31(baseValue + float3(0.0, 0.0, 1.0));
    float n101 = Hash31(baseValue + float3(1.0, 0.0, 1.0));
    float n011 = Hash31(baseValue + float3(0.0, 1.0, 1.0));
    float n111 = Hash31(baseValue + float3(1.0, 1.0, 1.0));

    float x00 = lerp(n000, n100, smoothFraction.x);
    float x10 = lerp(n010, n110, smoothFraction.x);
    float x01 = lerp(n001, n101, smoothFraction.x);
    float x11 = lerp(n011, n111, smoothFraction.x);
    float y0 = lerp(x00, x10, smoothFraction.y);
    float y1 = lerp(x01, x11, smoothFraction.y);
    return lerp(y0, y1, smoothFraction.z);
}

float3 TransformLocalToWorld(StylizedCrownClusterData cluster, float3 localPos)
{
    // 椭球局部坐标 -> 世界坐标。控制点的旋转会体现在 axisX/Y/Z 上。
    return cluster.centerWS
        + cluster.axisXWS * localPos.x
        + cluster.axisYWS * localPos.y
        + cluster.axisZWS * localPos.z;
}

float3 ComputeShellNormalWS(StylizedCrownClusterData cluster, float3 localPosN)
{
    // 使用椭球隐式曲面的梯度近似外壳法线，
    // 比直接用球体法线更适合被拉伸过的叶团。
    float3 gradient = cluster.axisXWS * (localPosN.x / max(cluster.extents.x, 1e-4))
        + cluster.axisYWS * (localPosN.y / max(cluster.extents.y, 1e-4))
        + cluster.axisZWS * (localPosN.z / max(cluster.extents.z, 1e-4));
    return SafeNormalize(gradient);
}

float3 SampleShellBiasedUnitPoint(inout uint state, float shellBias)
{
    // 在单位球内采样，并把半径分布向外壳偏置，
    // 这样叶片更容易堆在外层，不会像实心棉花球。
    float3 direction = RandomUnitVector(state);
    float u = max(Random01(state), 1e-5);
    float exponent = lerp(3.4, 0.42, shellBias);
    float radius01 = pow(u, exponent);
    float shellFloor = lerp(_CenterVoid * 0.2, _CenterVoid, shellBias);
    radius01 = lerp(shellFloor, 1.0, radius01);
    return direction * saturate(radius01);
}

float EvaluateCandidate(StylizedCrownClusterData cluster, float3 localPosN, float shellBias)
{
    // 从多个候选点中挑“更像动画树”的点：
    // 外壳权重 + 高度偏好 + 低频噪声团块。
    float radius01 = saturate(length(localPosN));
    float shell = saturate((radius01 - _CenterVoid) / max(1.0 - _CenterVoid, 1e-4));
    float shellScore = pow(shell, lerp(2.0, 0.6, shellBias));
    float localHeight01 = saturate(localPosN.y * 0.5 + 0.5);
    float clumpNoise = ValueNoise(localPosN * 3.8 + float3(cluster.layer * 13.0, cluster.depthInCrown * 7.0, cluster.radius * 5.0));
    float clumpWeight = lerp(0.8, 1.25, clumpNoise);
    float heightWeight = lerp(0.92, 1.08, localHeight01 * (1.0 - cluster.layer * 0.5));
    return shellScore * clumpWeight * heightWeight;
}

uint FindClusterIndex(uint cardIndex)
{
    // 根据全局 cardIndex 反查它属于哪个 cluster。
    // 当前是线性查找，重建频繁时可继续优化成区间表。
    [loop]
    for (uint i = 0u; i < _ClusterCount; i++)
    {
        StylizedCrownClusterData cluster = _Clusters[i];
        uint endIndex = cluster.startCardIndex + cluster.cardCount;
        if (cardIndex >= cluster.startCardIndex && cardIndex < endIndex)
            return i;
    }

    return 0u;
}

float EvaluateBlocker(StylizedCrownClusterData receiver, StylizedCrownClusterData blocker, float3 lightDirWS)
{
    // 便宜的团间方向遮挡：
    // 只判断“挡光团是否在上游、横向是否覆盖、距离是否足够近”。
    float3 delta = blocker.centerWS - receiver.centerWS;
    float upstream = dot(delta, lightDirWS);
    if (upstream <= 0.0)
        return 0.0;

    float3 lateral = delta - lightDirWS * upstream;
    float lateralDistance = length(lateral);
    float coverRadius = blocker.radius + receiver.radius * 0.6;
    float cover = saturate(1.0 - lateralDistance / max(coverRadius, 1e-4));
    if (cover <= 0.0)
        return 0.0;

    float distance01 = upstream / max(blocker.radius + receiver.radius, 1e-4);
    float axialFade = exp(-distance01 * _ClusterOcclusionDistanceFade);
    float layerBoost = lerp(0.9, 1.2, saturate(1.0 - blocker.layer));
    float depthBoost = lerp(0.85, 1.2, blocker.depthInCrown);
    return cover * cover * axialFade * blocker.density * blocker.directOcclBias * layerBoost * depthBoost;
}

bool IsSphereVisible(float3 positionWS, float radius)
{
    // 卡片级剔除使用包围球，宁可偏保守一些，也不要轻易把整团剔空。
    if (_FrustumCullingEnabled == 0)
        return true;

    radius += _FrustumCullPadding;

    [unroll]
    for (int i = 0; i < 6; i++)
    {
        float distanceToPlane = dot(_FrustumPlanes[i], float4(positionWS, 1.0));
        if (distanceToPlane < -radius)
            return false;
    }

    return true;
}

[numthreads(64, 1, 1)]
void GenerateLeafCards(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    // 生成所有叶片实例：
    // 先按 cluster 找到所属叶团，再做偏外壳采样、尺寸/旋转/风相位随机化。
    uint cardIndex = dispatchThreadId.x;
    if (cardIndex >= _TotalCardCount)
        return;

    uint clusterIndex = FindClusterIndex(cardIndex);
    StylizedCrownClusterData cluster = _Clusters[clusterIndex];
    uint localCardIndex = cardIndex - cluster.startCardIndex;

    uint state = Hash(cardIndex + clusterIndex * 19349663u + _GlobalRandomSeed * 83492791u);
    float shellBias = saturate(lerp(_GlobalShellBias, cluster.shellBias, 0.7));

    CandidateData best;
    best.localPosN = float3(0.0, 1.0, 0.0);
    best.shell = 1.0;
    best.score = -1.0;

    [loop]
    for (uint attempt = 0u; attempt < kCandidateAttempts; attempt++)
    {
        // 用多次候选采样提升团块感，而不是把卡片均匀撒进椭球内部。
        float3 candidatePosN = SampleShellBiasedUnitPoint(state, shellBias);
        float radius01 = saturate(length(candidatePosN));
        float shell = saturate((radius01 - _CenterVoid) / max(1.0 - _CenterVoid, 1e-4));
        float score = EvaluateCandidate(cluster, candidatePosN, shellBias);
        if (score > best.score)
        {
            best.localPosN = candidatePosN;
            best.shell = shell;
            best.score = score;
        }
    }

    float3 localPos = best.localPosN * cluster.extents;
    float3 positionWS = TransformLocalToWorld(cluster, localPos);
    float3 shellNormalWS = ComputeShellNormalWS(cluster, best.localPosN);
    float upBias = saturate(lerp(_GlobalUpBias, cluster.upFacingBias, 0.7));
    float height01 = saturate(best.localPosN.y * 0.5 + 0.5);
    float3 outwardNormalWS = SafeNormalize(lerp(shellNormalWS, cluster.axisYWS, upBias * height01));

    StylizedLeafCardData card;
    card.positionWS = positionWS;
    card.size = lerp(_LeafSizeRange.x, _LeafSizeRange.y, Random01(state)) * cluster.leafSizeScale * lerp(0.88, 1.14, Random01(state));
    card.localPosN = best.localPosN;
    card.rotation = Random01(state) * kTwoPi;
    card.outwardNormalWS = outwardNormalWS;
    card.shell = best.shell;
    card.random01 = Random01(state);
    card.hueVariation = Random01(state) * 2.0 - 1.0;
    card.ao = saturate(1.0 - cluster.ambientOccl * (1.0 - best.shell));
    card.windPhase = Random01(state) * kTwoPi + localCardIndex * 0.013;
    card.clusterId = clusterIndex;
    card.padding = 0.0;

    _AllLeafCards[cardIndex] = card;
}

[numthreads(64, 1, 1)]
void EvaluateClusterOcclusion(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    // 每个叶团继承一个 cluster 级别的挡光系数，
    // 片元着色时直接读取，避免做真实阴影。
    uint clusterIndex = dispatchThreadId.x;
    if (clusterIndex >= _ClusterCount)
        return;

    StylizedCrownClusterData receiver = _Clusters[clusterIndex];
    float3 lightDirWS = SafeNormalize(_LightDirectionWS);
    float opticalDepth = 0.0;

    [loop]
    for (uint i = 0u; i < _ClusterCount; i++)
    {
        if (i == clusterIndex)
            continue;

        opticalDepth += EvaluateBlocker(receiver, _Clusters[i], lightDirWS);
    }

    float transmittance = exp(-opticalDepth * _ClusterOcclusionSigma);
    receiver.directionalTransmittance = transmittance;
    receiver.directionalOcclusion = saturate(1.0 - transmittance);
    _Clusters[clusterIndex] = receiver;
}

[numthreads(1, 1, 1)]
void ResetVisibleCounter(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    // 可见计数器每帧开始前必须清零。
    _VisibleCardCounter[0] = 0u;
}

[numthreads(64, 1, 1)]
void CullAndLod(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    // 逐卡片执行：
    // 距离 LOD 保留率 -> 视锥剔除 -> 写入可见缓冲。
    uint cardIndex = dispatchThreadId.x;
    if (cardIndex >= _TotalCardCount)
        return;

    StylizedLeafCardData card = _AllLeafCards[cardIndex];
    float distanceToCamera = distance(card.positionWS, _CameraPositionWS);
    float lodT = saturate((distanceToCamera - _LodNearDistance) / max(_LodFarDistance - _LodNearDistance, 1e-4));
    float keepRatio = lerp(1.0, _LodFarKeepRatio, lodT);
    if (card.random01 > keepRatio)
        return;

    float lodScale = lerp(1.0, _LodFarScale, lodT);
    float cullRadius = max(card.size * lodScale * 1.35, 0.02);
    if (!IsSphereVisible(card.positionWS, cullRadius))
        return;

    uint visibleIndex;
    InterlockedAdd(_VisibleCardCounter[0], 1u, visibleIndex);
    card.size *= lodScale;
    _VisibleLeafCards[visibleIndex] = card;
}

[numthreads(1, 1, 1)]
void BuildIndirectArgs(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    // 只更新 indirect args 里的 instanceCount，索引信息由 CPU 初始化。
    uint visibleCount = _VisibleCardCounter[0];
    _IndirectArgs.Store(4, visibleCount);
    _IndirectArgs.Store(16, 0u);
}




