#pragma kernel GenerateBlades
#pragma kernel CullClusters
#pragma kernel CullAndLod
#pragma kernel FixupCullDispatchArgs

static const float kPi = 3.14159265359;

struct GrassBlade
{
    float3 positionWS;
    float rotAngle;
    float hash;
    float height;
    float width;
    float tilt;
    float bend;
};

struct VisibleGrassInstance
{
    uint bladeIndex;
    float rotAngle;
    float windForce;
    float padding;
};

struct ClumpParameters
{
    float pullToCentre;
    float pointInSameDirection;
    float baseHeight;
    float heightRandom;
    float baseWidth;
    float widthRandom;
    float baseTilt;
    float tiltRandom;
    float baseBend;
    float bendRandom;
    float clusterRadius;
    float grassPerCluster;
};

struct ClusterInstance
{
    float3 centerWS;
    float sigma;
    uint grassCount;
    uint clumpTypeIndex;
    float sharedFacingAngle;
    uint startIndex;
};

struct ClusterDispatch
{
    uint clusterIndex;
    uint sampleOffset;
};

struct ClusterCullingData
{
    float3 minWS;
    uint dispatchStartIndex;
    float3 maxWS;
    uint dispatchCount;
};

RWStructuredBuffer<GrassBlade> _GeneratedGrassBlades;
AppendStructuredBuffer<VisibleGrassInstance> _GrassBladesLod0;
AppendStructuredBuffer<VisibleGrassInstance> _GrassBladesLod1;
AppendStructuredBuffer<VisibleGrassInstance> _GrassBladesLod2;
StructuredBuffer<ClusterInstance> _ClusterInstancesBuffer;
StructuredBuffer<ClusterCullingData> _ClusterCullingDataBuffer;
StructuredBuffer<ClusterDispatch> _ClusterDispatchBuffer;
StructuredBuffer<ClusterDispatch> _VisibleClusterDispatchBuffer;
AppendStructuredBuffer<ClusterDispatch> _VisibleClusterDispatchAppendBuffer;
StructuredBuffer<ClumpParameters> _ClumpParametersBuffer;
RWByteAddressBuffer _CullDispatchArgsBuffer;

uint _ClusterCount;
uint _ClusterCullingCount;
uint _ClusterDispatchCount;
uint _GeneratedGrassBladeCount;
int _ClumpParameterCount;
uint _DispatchGridWidth;
float3 _TerrainPosition;
float3 _TerrainSize;
float _HeightMapMultiplier;
float3 _WSpaceCameraPos;
float _DistanceCullStartDist;
float _DistanceCullEndDist;
float _DistanceCullMinimumGrassAmount;
float4x4 _VP_MATRIX;
float4 _FrustumPlanes[6];
float _FrustumCullNearOffset;
float _FrustumCullEdgeOffset;
int _EnableDistanceCull;
int _EnableFrustumCull;

Texture2D<float4> _HeightMap;
SamplerState sampler_HeightMap;
Texture2D<float4> _LocalWindTex;
SamplerState sampler_LocalWindTex;
float _LocalWindScale;
float _LocalWindSpeed;
float _LocalWindStrength;
float _LocalWindRotateAmount;
float _Lod0EndDistance;
float _Lod1EndDistance;
float _LodTransitionWidth;
float _Time;

float Rand(float3 value)
{
    return frac(sin(dot(value, float3(12.9898, 78.233, 53.539))) * 43758.5453);
}

float2 HashFloat2(float2 value)
{
    float t = dot(value, float2(12.9898, 78.233));
    float2 q = float2(t, t * 1.61803398875);
    return frac(sin(q) * 43758.5453);
}

float Remap(float value)
{
    return (value * 2.0) - 1.0;
}

float SampleHeight(float2 normalizedPos)
{
    return _HeightMap.SampleLevel(sampler_HeightMap, normalizedPos, 0).r * _HeightMapMultiplier;
}

uint FrustumCull(float3 worldPos)
{
    float4 clipPos = mul(_VP_MATRIX, float4(worldPos, 1.0));

    return (clipPos.z > clipPos.w
        || clipPos.z < 0.0
        || clipPos.x < -clipPos.w - _FrustumCullEdgeOffset
        || clipPos.x > clipPos.w + _FrustumCullEdgeOffset
        || clipPos.y < -clipPos.w + _FrustumCullNearOffset
        || clipPos.y > clipPos.w)
        ? 0u
        : 1u;
}

uint DistanceCull(float distanceToCamera, float hash)
{
    float visibility = _DistanceCullEndDist <= _DistanceCullStartDist
        ? (distanceToCamera <= _DistanceCullStartDist ? 1.0 : 0.0)
        : (1.0 - smoothstep(_DistanceCullStartDist, _DistanceCullEndDist, distanceToCamera));
    float keptAmount = lerp(_DistanceCullMinimumGrassAmount, 1.0, visibility);
    return hash > 1.0 - keptAmount ? 1u : 0u;
}

VisibleGrassInstance MakeVisibleGrassInstance(uint bladeIndex, float rotAngle, float windForce, float signedLodFade)
{
    VisibleGrassInstance instance;
    instance.bladeIndex = bladeIndex;
    instance.rotAngle = rotAngle;
    instance.windForce = windForce;
    instance.padding = signedLodFade;
    return instance;
}

void AppendBladeToLod0(uint bladeIndex, float rotAngle, float windForce, float signedLodFade)
{
    if (abs(signedLodFade) <= 0.001)
        return;

    _GrassBladesLod0.Append(MakeVisibleGrassInstance(bladeIndex, rotAngle, windForce, signedLodFade));
}

void AppendBladeToLod1(uint bladeIndex, float rotAngle, float windForce, float signedLodFade)
{
    if (abs(signedLodFade) <= 0.001)
        return;

    _GrassBladesLod1.Append(MakeVisibleGrassInstance(bladeIndex, rotAngle, windForce, signedLodFade));
}

void AppendBladeToLod2(uint bladeIndex, float rotAngle, float windForce, float signedLodFade)
{
    if (abs(signedLodFade) <= 0.001)
        return;

    _GrassBladesLod2.Append(MakeVisibleGrassInstance(bladeIndex, rotAngle, windForce, signedLodFade));
}

void AppendBladeToLod(uint bladeIndex, float rotAngle, float windForce, float distanceToCamera)
{
    if (distanceToCamera <= _Lod0EndDistance)
    {
        AppendBladeToLod0(bladeIndex, rotAngle, windForce, 1.0);
        return;
    }

    if (distanceToCamera <= _Lod1EndDistance)
    {
        AppendBladeToLod1(bladeIndex, rotAngle, windForce, 1.0);
        return;
    }

    AppendBladeToLod2(bladeIndex, rotAngle, windForce, 1.0);
}

float AabbSqrDistanceToPoint(float3 minWS, float3 maxWS, float3 pointWS)
{
    float3 nearestPointWS = clamp(pointWS, minWS, maxWS);
    float3 delta = pointWS - nearestPointWS;
    return dot(delta, delta);
}

uint FrustumCullAabb(float3 minWS, float3 maxWS)
{
    float3 centerWS = (minWS + maxWS) * 0.5;
    float3 extentsWS = (maxWS - minWS) * 0.5;

    [unroll]
    for (int i = 0; i < 6; i++)
    {
        float4 plane = _FrustumPlanes[i];
        float distanceToPlane = dot(plane.xyz, centerWS) + plane.w;
        float projectedRadius = dot(abs(plane.xyz), extentsWS);
        if (distanceToPlane + projectedRadius < 0.0)
            return 0u;
    }

    return 1u;
}

[numthreads(64, 1, 1)]
void GenerateBlades(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    uint dispatchIndex = groupId.x + (groupId.y * _DispatchGridWidth);
    if (_ClusterCount == 0 || _ClusterDispatchCount == 0 || _ClumpParameterCount <= 0 || dispatchIndex >= _ClusterDispatchCount)
        return;

    ClusterDispatch clusterDispatch = _ClusterDispatchBuffer[dispatchIndex];
    if (clusterDispatch.clusterIndex >= _ClusterCount)
        return;

    ClusterInstance cluster = _ClusterInstancesBuffer[clusterDispatch.clusterIndex];
    uint localBladeIndex = clusterDispatch.sampleOffset + groupThreadId.x;
    if (localBladeIndex >= cluster.grassCount)
        return;

    uint bladeIndex = cluster.startIndex + localBladeIndex;
    if (bladeIndex >= _GeneratedGrassBladeCount)
        return;

    uint clumpTypeIndex = min(cluster.clumpTypeIndex, (uint)max(0, _ClumpParameterCount - 1));
    ClumpParameters bladeParameters = _ClumpParametersBuffer[clumpTypeIndex];

    float3 seedBase = float3((float)clusterDispatch.clusterIndex + 1.37, (float)localBladeIndex + 2.91, cluster.sharedFacingAngle + 0.73);
    float bladeCount = max(1.0, (float)cluster.grassCount);
    float normalizedIndex = ((float)localBladeIndex + 0.5) / bladeCount;
    float radialJitter = Remap(Rand(seedBase + float3(0.17, 0.31, 0.73))) * (0.75 / bladeCount);
    float angleJitter = Remap(Rand(seedBase + float3(2.11, 1.37, 4.19))) * 0.35;
    float radius01 = sqrt(saturate(normalizedIndex + radialJitter));
    float theta = ((float)localBladeIndex + angleJitter) * 2.39996323;
    float edgeJitter = 1.0 + Remap(Rand(seedBase + float3(6.91, 3.73, 1.43))) * 0.08;
    float radius = cluster.sigma * radius01 * edgeJitter;
    float2 uniformOffset = radius * float2(cos(theta), sin(theta));

    float3 position = cluster.centerWS;
    position.xz += uniformOffset;

    float2 normalizedPos = (position.xz - _TerrainPosition.xz) / max(_TerrainSize.xz, float2(0.0001, 0.0001));
    // Safety clamp only. Cluster centers are already biased inward on CPU so this should
    // only catch tiny numeric edge cases instead of folding a whole cluster onto the border.
    normalizedPos = saturate(normalizedPos);
    position.xz = _TerrainPosition.xz + normalizedPos * _TerrainSize.xz;
    position.y = _TerrainPosition.y + SampleHeight(normalizedPos);

    float2 sharedClumpFacing = float2(cos(cluster.sharedFacingAngle), sin(cluster.sharedFacingAngle));
    float2 randomFacing = HashFloat2(float2((float)clusterDispatch.clusterIndex * 19.19 + localBladeIndex, (float)localBladeIndex * 7.73 + cluster.sharedFacingAngle)) * 2.0 - 1.0;
    float2 bladeFacing = normalize(randomFacing + float2(1e-5, 0.0));
    bladeFacing = normalize(lerp(bladeFacing, sharedClumpFacing, bladeParameters.pointInSameDirection));

    GrassBlade blade;
    blade.positionWS = position;
    blade.rotAngle = atan2(bladeFacing.y, bladeFacing.x);
    blade.hash = Rand(seedBase + float3(5.13, 2.17, 7.31));
    blade.height = max(0.05, bladeParameters.baseHeight + Remap(Rand(seedBase + float3(1.12, 3.3, 17.6))) * bladeParameters.heightRandom);
    blade.width = max(0.005, bladeParameters.baseWidth + Remap(Rand(seedBase + float3(9.41, 0.29, 5.17))) * bladeParameters.widthRandom);
    blade.tilt = clamp(bladeParameters.baseTilt + Remap(Rand(seedBase + float3(4.73, 8.11, 2.53))) * bladeParameters.tiltRandom, -0.9999, 0.9999);
    blade.bend = bladeParameters.baseBend + Remap(Rand(seedBase + float3(12.32, 0.23, 3.39))) * bladeParameters.bendRandom;

    _GeneratedGrassBlades[bladeIndex] = blade;
}

[numthreads(64, 1, 1)]
void CullClusters(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    uint cullingIndex = groupThreadId.x + ((groupId.x + (groupId.y * _DispatchGridWidth)) * 64u);
    if (_ClusterCullingCount == 0 || cullingIndex >= _ClusterCullingCount)
        return;

    ClusterCullingData cullingData = _ClusterCullingDataBuffer[cullingIndex];
    if (cullingData.dispatchCount == 0u)
        return;

    if (_EnableFrustumCull != 0 && FrustumCullAabb(cullingData.minWS, cullingData.maxWS) == 0u)
        return;

    float maxDistanceSqr = _DistanceCullEndDist * _DistanceCullEndDist;
    if (_EnableDistanceCull != 0 && _DistanceCullMinimumGrassAmount <= 0.0 && AabbSqrDistanceToPoint(cullingData.minWS, cullingData.maxWS, _WSpaceCameraPos) > maxDistanceSqr)
        return;

    uint dispatchEndIndex = min(cullingData.dispatchStartIndex + cullingData.dispatchCount, _ClusterDispatchCount);
    for (uint dispatchIndex = cullingData.dispatchStartIndex; dispatchIndex < dispatchEndIndex; dispatchIndex++)
        _VisibleClusterDispatchAppendBuffer.Append(_ClusterDispatchBuffer[dispatchIndex]);
}

[numthreads(64, 1, 1)]
void CullAndLod(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    uint dispatchGridWidth = _CullDispatchArgsBuffer.Load(0);
    uint visibleDispatchCount = _CullDispatchArgsBuffer.Load(12);
    uint visibleDispatchIndex = groupId.x + (groupId.y * dispatchGridWidth);
    if (visibleDispatchIndex >= visibleDispatchCount)
        return;

    ClusterDispatch clusterDispatch = _VisibleClusterDispatchBuffer[visibleDispatchIndex];
    if (clusterDispatch.clusterIndex >= _ClusterCount)
        return;

    ClusterInstance cluster = _ClusterInstancesBuffer[clusterDispatch.clusterIndex];
    uint localBladeIndex = clusterDispatch.sampleOffset + groupThreadId.x;
    if (localBladeIndex >= cluster.grassCount)
        return;

    uint bladeIndex = cluster.startIndex + localBladeIndex;
    if (_GeneratedGrassBladeCount == 0 || bladeIndex >= _GeneratedGrassBladeCount)
        return;

    GrassBlade blade = _GeneratedGrassBlades[bladeIndex];

    if (_EnableFrustumCull != 0 && FrustumCull(blade.positionWS) == 0u)
        return;

    float distanceToCamera = distance(blade.positionWS, _WSpaceCameraPos);
    if (_EnableDistanceCull != 0 && DistanceCull(distanceToCamera, blade.hash) == 0u)
        return;

    float2 bladeFacing = float2(cos(blade.rotAngle), sin(blade.rotAngle));
    float2 localWindUV = blade.positionWS.xz * _LocalWindScale;
    localWindUV += _Time * float2(1.0, 0.7) * _LocalWindSpeed;

    float localWind = _LocalWindTex.SampleLevel(sampler_LocalWindTex, localWindUV, 0).r;
    float localTheta = ((localWind * 2.0) - 1.0) * kPi;
    float2 localWindDir = float2(cos(localTheta), sin(localTheta));
    float2 grassSideVec = normalize(float2(-bladeFacing.y, bladeFacing.x));
    float rotateBladeFromLocalWindAmount = dot(grassSideVec, localWindDir);
    float localWindRotateAngle = rotateBladeFromLocalWindAmount * (kPi * 0.5) * _LocalWindRotateAmount;
    float windForce = localWind * _LocalWindStrength;

    AppendBladeToLod(bladeIndex, blade.rotAngle + localWindRotateAngle, windForce, distanceToCamera);
}

[numthreads(1, 1, 1)]
void FixupCullDispatchArgs(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (dispatchThreadId.x != 0u)
        return;

    uint visibleDispatchCount = _CullDispatchArgsBuffer.Load(0);
    if (visibleDispatchCount == 0u)
    {
        _CullDispatchArgsBuffer.Store(0, 0u);
        _CullDispatchArgsBuffer.Store(4, 1u);
        _CullDispatchArgsBuffer.Store(8, 1u);
        _CullDispatchArgsBuffer.Store(12, 0u);
        return;
    }

    uint dispatchGridWidth = min(visibleDispatchCount, 65535u);
    uint dispatchGridHeight = (visibleDispatchCount + dispatchGridWidth - 1u) / dispatchGridWidth;
    _CullDispatchArgsBuffer.Store(0, dispatchGridWidth);
    _CullDispatchArgsBuffer.Store(4, max(1u, dispatchGridHeight));
    _CullDispatchArgsBuffer.Store(8, 1u);
    _CullDispatchArgsBuffer.Store(12, visibleDispatchCount);
}
