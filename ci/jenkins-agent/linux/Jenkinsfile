pipeline {
    agent {
        node {
            label 'unity6-cloud-agent'
            customWorkspace '/workspace'
        }
    }

    options {
        timestamps()
        timeout(time: 180, unit: 'MINUTES')
        skipDefaultCheckout(true)
    }

    parameters {
        string(name: 'GIT_REPOSITORY_URL', defaultValue: 'ssh://git@ssh.github.com:443/whanser220-ops/Build.git', description: 'Git repository cloned inside the Docker volume workspace.')
        string(name: 'GIT_REF', defaultValue: 'Main', description: 'Git branch, tag, or ref fetched inside the Docker volume workspace.')
        booleanParam(name: 'P4_SYNC_ENABLED', defaultValue: true, description: 'Sync Unity assets from Perforce before building.')
        string(name: 'P4_PORT', defaultValue: 'ssl:1.117.232.198:1666', description: 'Perforce server address.')
        string(name: 'P4_CREDENTIALS_ID', defaultValue: 'perforce-jenkins', description: 'Jenkins username/password credential ID for Perforce.')
        string(name: 'P4_CLIENT', defaultValue: 'jenkins_unity_linux_agent_art', description: 'Perforce workspace/client used by the Linux container agent.')
        string(name: 'P4_ASSET_CL', defaultValue: '', description: 'Optional Perforce changelist to pin the asset sync. Leave empty for latest.')
    }

    environment {
        UNITY_PROJECT_PATH = '/workspace'
        UNITY_LICENSE_MODE = 'personal'
        BUILD_MANIFEST = '.workspace/build-manifest.json'
        P4_SYNC_LOG = 'Logs/p4-sync.log'
        BUILD_METRICS_URL = 'http://1.117.232.198/api/build-metrics/events'
        BUILD_METRICS_JOB = 'unity-linux-docker-build'
    }

    stages {
        stage('Agent') {
            steps {
                withCredentials([string(credentialsId: 'build-metrics-ingest-token', variable: 'BUILD_METRICS_INGEST_TOKEN')]) {
                    withEnv(["BUILD_METRICS_RUN_ID=${env.JOB_NAME}-${env.BUILD_NUMBER}"]) {
                        sh '''
set -eux
report-build-metrics.sh --event stage_started --stage-id agent --stage "Agent ready" --state running --message "Jenkins Unity Linux agent is online." || true
java -version
/opt/unity/Editor/Unity -version
git lfs version
p4 -V | head -20
du -sh /workspace || true
du -sh /workspace/Library || true
report-build-metrics.sh --event stage_finished --stage-id agent --stage "Agent ready" --state success --result SUCCESS --message "Jenkins Unity Linux agent is ready." || true
'''
                    }
                }
            }
        }

        stage('Build Windows Player') {
            steps {
                script {
                    def gitRepositoryUrl = params.GIT_REPOSITORY_URL ?: 'ssh://git@ssh.github.com:443/whanser220-ops/Build.git'
                    def gitRef = params.GIT_REF ?: 'Main'
                    def p4SyncEnabled = (params.P4_SYNC_ENABLED == null) ? 'true' : params.P4_SYNC_ENABLED.toString()
                    def p4Port = params.P4_PORT ?: 'ssl:1.117.232.198:1666'
                    def p4CredentialsId = params.P4_CREDENTIALS_ID ?: 'perforce-jenkins'
                    def p4Client = params.P4_CLIENT ?: 'jenkins_unity_linux_agent_art'
                    def p4AssetCl = params.P4_ASSET_CL ?: ''

                    withCredentials([
                        usernamePassword(
                            credentialsId: p4CredentialsId,
                            usernameVariable: 'P4_USERNAME',
                            passwordVariable: 'P4_PASSWORD'
                        ),
                        string(
                            credentialsId: 'build-metrics-ingest-token',
                            variable: 'BUILD_METRICS_INGEST_TOKEN'
                        ),
                        sshUserPrivateKey(
                            credentialsId: 'build-github-deploy-key',
                            keyFileVariable: 'GIT_SSH_KEY'
                        )
                    ]) {
                        withEnv([
                            "GIT_REPOSITORY_URL=${gitRepositoryUrl}",
                            "GIT_REF=${gitRef}",
                            "P4_SYNC_ENABLED=${p4SyncEnabled}",
                            "P4_PORT=${p4Port}",
                            "P4_CLIENT=${p4Client}",
                            "P4_ASSET_CL=${p4AssetCl}",
                            "BUILD_METRICS_RUN_ID=${env.JOB_NAME}-${env.BUILD_NUMBER}"
                        ]) {
                        sh '''
set -eux
export P4_PORT="${P4_PORT:-ssl:1.117.232.198:1666}"
export P4_CLIENT_NAME="${P4_CLIENT:-jenkins_unity_linux_agent_art}"
export P4_ASSET_CL="${P4_ASSET_CL:-}"
export P4_SYNC_ENABLED="${P4_SYNC_ENABLED:-true}"
export GIT_REPOSITORY_URL="${GIT_REPOSITORY_URL:-ssh://git@ssh.github.com:443/whanser220-ops/Build.git}"
export GIT_REF="${GIT_REF:-Main}"
export GIT_SSH_COMMAND="ssh -i ${GIT_SSH_KEY} -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"

report-build-metrics.sh --event stage_started --stage-id bootstrap --stage "Bootstrap workspace" --state running --message "Bootstrapping Unity workspace." || true
export BOOTSTRAP_ONLY=true
bootstrap-unity-workspace.sh
report-build-metrics.sh --event stage_finished --stage-id bootstrap --stage "Bootstrap workspace" --state success --result SUCCESS --message "Unity workspace bootstrapped." || true

cat > ProjectSettings/EditorBuildSettings.asset <<'EOF'
%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!1045 &1
EditorBuildSettings:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Scenes:
  - enabled: 1
    path: Assets/Game/Worlds/Meadow/Runtime/Scenes/Scene_MeadowEnvironment_01_Summer.unity
    guid: 08ab2a5dde032ba428d3d349acd1dc09
  m_configObjects: {}
EOF

unset BOOTSTRAP_ONLY
if [ "${P4_SYNC_ENABLED}" != "false" ]; then
    report-build-metrics.sh --event stage_started --stage-id p4-sync --stage "Perforce asset sync" --state running --message "Syncing Perforce assets." || true
    bash ci/jenkins-agent/linux/scripts/sync-perforce-assets.sh
    report-build-metrics.sh --event stage_finished --stage-id p4-sync --stage "Perforce asset sync" --state success --result SUCCESS --message "Perforce asset sync completed." || true
else
    report-build-metrics.sh --event stage_started --stage-id p4-sync --stage "Perforce asset sync" --state running --message "Perforce asset sync skipped." || true
    report-build-metrics.sh --event stage_finished --stage-id p4-sync --stage "Perforce asset sync" --state success --result SUCCESS --message "Perforce asset sync skipped." || true
fi

report-build-metrics.sh --event stage_started --stage-id sanitize-source-art --stage "Sanitize source art filenames" --state running --message "Removing unsupported non-ASCII source art filenames." || true
python3 - <<'PY'
import os
root = '/workspace/Assets/Game/Characters/Qianxia/Art'
removed = []
if os.path.isdir(root):
    for dirpath, _, filenames in os.walk(root):
        for name in filenames:
            if any(ord(ch) > 127 for ch in name):
                path = os.path.join(dirpath, name)
                os.remove(path)
                removed.append(path)
print('Removed non-ASCII Qianxia source art files:')
for path in removed:
    print(' - ' + path)
PY
report-build-metrics.sh --event stage_finished --stage-id sanitize-source-art --stage "Sanitize source art filenames" --state success --result SUCCESS --message "Unsupported source art filename cleanup completed." || true

export P4_SYNC_ENABLED=false
report-build-metrics.sh --event stage_started --stage-id unity-build-script --stage "Unity build script" --state running --message "Starting Unity build wrapper." || true
build-unity-windows.sh
report-build-metrics.sh --event stage_finished --stage-id unity-build-script --stage "Unity build script" --state success --result SUCCESS --message "Unity build wrapper completed." || true
'''
                        }
                    }
                }
            }
        }
    }

    post {
        failure {
            withCredentials([string(credentialsId: 'build-metrics-ingest-token', variable: 'BUILD_METRICS_INGEST_TOKEN')]) {
                withEnv(["BUILD_METRICS_RUN_ID=${env.JOB_NAME}-${env.BUILD_NUMBER}"]) {
                    sh '''
report-build-metrics.sh --event run_finished --stage-id pipeline-failure --stage "Pipeline failure" --state failure --result FAILURE --message "Unity Linux Docker build failed." || true
'''
                }
            }
        }
        always {
            archiveArtifacts artifacts: 'Logs/*.log,.workspace/build-manifest.json,.workspace/artifacts/yooasset/**/*.json', allowEmptyArchive: true
        }
    }
}
