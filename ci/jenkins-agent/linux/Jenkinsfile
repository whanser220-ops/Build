pipeline {
    agent {
        node {
            label 'unity-linux-docker'
            customWorkspace '/workspace'
        }
    }

    options {
        timestamps()
        timeout(time: 180, unit: 'MINUTES')
        skipDefaultCheckout(true)
    }

    parameters {
        string(name: 'GIT_REPOSITORY_URL', defaultValue: 'https://github.com/whanser220-ops/Build.git', description: 'Git repository cloned inside the Docker volume workspace.')
        string(name: 'GIT_REF', defaultValue: 'Main', description: 'Git branch, tag, or ref fetched inside the Docker volume workspace.')
        booleanParam(name: 'P4_SYNC_ENABLED', defaultValue: true, description: 'Sync Unity assets from Perforce before building.')
        string(name: 'P4_PORT', defaultValue: 'ssl:1.117.232.198:1666', description: 'Perforce server address.')
        string(name: 'P4_CREDENTIALS_ID', defaultValue: 'perforce-jenkins', description: 'Jenkins username/password credential ID for Perforce.')
        string(name: 'P4_CLIENT', defaultValue: 'jenkins_unity_linux_agent_art', description: 'Perforce workspace/client used by the Linux container agent.')
        string(name: 'P4_ASSET_CL', defaultValue: '', description: 'Optional Perforce changelist to pin the asset sync. Leave empty for latest.')
    }

    environment {
        UNITY_PROJECT_PATH = '/workspace'
        UNITY_LICENSE_MODE = 'personal'
        BUILD_MANIFEST = '.workspace/build-manifest.json'
        P4_SYNC_LOG = 'Logs/p4-sync.log'
    }

    stages {
        stage('Agent') {
            steps {
                sh '''
set -eux
java -version
/opt/unity/Editor/Unity -version
git lfs version
p4 -V | head -20
du -sh /workspace || true
du -sh /workspace/Library || true
'''
            }
        }

        stage('Build Windows Player') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: params.P4_CREDENTIALS_ID,
                        usernameVariable: 'P4_USERNAME',
                        passwordVariable: 'P4_PASSWORD'
                    )]) {
                        sh '''
set -eux
export P4_PORT="${P4_PORT}"
export P4_CLIENT_NAME="${P4_CLIENT}"
export P4_ASSET_CL="${P4_ASSET_CL}"
export P4_SYNC_ENABLED="${P4_SYNC_ENABLED}"
export GIT_REPOSITORY_URL="${GIT_REPOSITORY_URL}"
export GIT_REF="${GIT_REF}"

export BOOTSTRAP_ONLY=true
bootstrap-unity-workspace.sh

cat > ProjectSettings/EditorBuildSettings.asset <<'EOF'
%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!1045 &1
EditorBuildSettings:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Scenes:
  - enabled: 1
    path: Assets/Game/Worlds/Meadow/Runtime/Scenes/Scene_MeadowEnvironment_01_Summer.unity
    guid: 08ab2a5dde032ba428d3d349acd1dc09
  m_configObjects: {}
EOF

unset BOOTSTRAP_ONLY
sync-perforce-assets.sh

python3 - <<'PY'
import os
root = '/workspace/Assets/Game/Characters/Qianxia/Art'
removed = []
if os.path.isdir(root):
    for dirpath, _, filenames in os.walk(root):
        for name in filenames:
            if any(ord(ch) > 127 for ch in name):
                path = os.path.join(dirpath, name)
                os.remove(path)
                removed.append(path)
print('Removed non-ASCII Qianxia source art files:')
for path in removed:
    print(' - ' + path)
PY

export P4_SYNC_ENABLED=false
build-unity-windows.sh
'''
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'Logs/*.log,.workspace/build-manifest.json,.workspace/artifacts/yooasset/**/*.json', allowEmptyArchive: true
        }
    }
}
